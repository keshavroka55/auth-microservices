generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// The admin service stores only what it OWNS.
// User data stays in the auth service; we keep ids, never copies of user rows.
model AuditLog {
  id           String   @id @default(uuid())
  adminId      String   @map("admin_id")
  action       String                          // e.g. USER_ROLE_CHANGED
  targetUserId String?  @map("target_user_id")
  metadata     Json?                           // e.g. { from: "chef", to: "admin" }
  ipAddress    String?  @map("ip_address")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([adminId])
  @@index([targetUserId])
  @@index([createdAt])
  @@map("audit_logs")
}
