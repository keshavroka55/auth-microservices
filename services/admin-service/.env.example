PORT=5001
NODE_ENV=development

# Admin service's OWN database (never the auth database)
DATABASE_URL="postgresql://admin_user:password123@localhost:5432/admin_database"

# Public key only. This service can verify tokens but can never create them.
ACCESS_TOKEN_PUBLIC_KEY_PATH=./keys/public.pem

# Where the auth-service lives, and the shared secret for its /internal API
AUTH_SERVICE_URL=http://localhost:5000
INTERNAL_API_KEY=change-me-to-a-long-random-string

# Only needed when the browser calls this service directly (no gateway/proxy)
CLIENT_URL=http://localhost:3000
